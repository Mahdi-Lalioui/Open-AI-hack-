# Copy to .env and fill in. Never commit a real key.
# Without OPENAI_API_KEY the app runs in clearly-labelled example mode.
OPENAI_API_KEY=sk-your-key-here

# Model IDs (configurable — change if your account lacks access to a model)
OPENAI_VISION_MODEL=gpt-6-astra
OPENAI_DECISIONS_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# Voice instructions in the Design Studio
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Optional: override the OpenAI API base URL (e.g. a proxy). Default https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Server
HOST=0.0.0.0
PORT=5173

# The URL audience phones will open (shown as the QR code). Must be reachable from phones,
# e.g. https://your-tunnel.example.com or http://192.168.1.20:5173 on the same Wi-Fi.
# If empty, the host page's own origin is used.
PUBLIC_BASE_URL=
